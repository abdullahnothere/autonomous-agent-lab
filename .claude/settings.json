{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(diff:*)",
      "Bash(tree:*)",
      "Bash(pwd)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm ls:*)",
      "Bash(npm audit)",
      "Bash(npm audit --json)",
      "Bash(npm outdated:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(node --test:*)",
      "Bash(bash scripts/validate-agents.sh:*)"
    ]
  }
}
