{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(pwd)",
      "Bash(git status:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git diff --cached --stat)",
      "Bash(git log --oneline)",
      "Bash(git show --stat)",
      "Bash(git branch --show-current)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm ls)",
      "Bash(npm audit)",
      "Bash(npm audit --json)",
      "Bash(npm outdated)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(bash scripts/validate-agents.sh)"
    ]
  }
}
